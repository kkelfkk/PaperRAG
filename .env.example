# Copy this file to .env for local development. Never commit real API keys.
PAPERRAG_ENV=development

# LLM provider: openai or qwen
LLM_PROVIDER=openai
OPENAI_API_KEY=
QWEN_API_KEY=

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Retrieval models
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
