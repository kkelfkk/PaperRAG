# Copy this file to .env for local development. Never commit real API keys.
PAPERRAG_ENV=development

# DeepSeek. Use a newly created key and keep it only in the local .env file.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# Embedded Qdrant
QDRANT_PATH=storage/qdrant
QDRANT_COLLECTION=paperrag_dense

# Retrieval models
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
